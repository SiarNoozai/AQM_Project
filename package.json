{
  "name": "portfolio-risk-analysis-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bash ./start-dev.sh",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "uv run --project backend uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "dev:backend:reload": "uv run --project backend uvicorn backend.main:app --reload --reload-dir backend --host 127.0.0.1 --port 8000",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^4.1.11"
  }
}

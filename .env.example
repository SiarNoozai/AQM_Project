VITE_API_BASE_URL=http://127.0.0.1:8000
# Only used by the local Vite dev server. Docker Compose uses http://backend:8000.
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Lokaler Ollama-Endpunkt und Standardmodell; ohne Ollama greift der Regelmodus.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# LM Studio: einzelne URL oder kommaseparierte URL-Liste, optionales Modell.
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_URLS=
LMSTUDIO_MODEL=
# Zeitlimit für lokale Modellanfragen in Sekunden.
LLM_TIMEOUT=90
# OpenAI-kompatibler Cloud-Provider (optional, z. B. NVIDIA NIM)
CLOUD_API_KEY=
CLOUD_BASE_URL=https://integrate.api.nvidia.com
CLOUD_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Comma-separated browser origins allowed to call the backend.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Legacy-Aliase werden weiterhin unterstützt: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
CLOUD_TIMEOUT=45
# Alpha Vantage NEWS_SENTIMENT; ohne Schlüssel werden keine News-Signale geladen.
ALPHA_VANTAGE_API_KEY=
